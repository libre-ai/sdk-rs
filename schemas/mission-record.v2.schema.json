{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/mission-record.v2.schema.json",
  "title": "Libre AI MissionRecord v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "revision",
    "state",
    "handoffId",
    "handoffDigest",
    "budgets",
    "acceptanceCriteria",
    "reviews",
    "eventCursor",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.mission-record.v2" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "revision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "state": {
      "enum": [
        "proposed",
        "assessed",
        "plan-review",
        "plan-rejected",
        "authorized",
        "running",
        "blocked",
        "paused",
        "cancelled",
        "result-submitted",
        "result-review",
        "validated",
        "rejected",
        "failed",
        "abandoned"
      ]
    },
    "handoffId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "handoffDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "policyVersion"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "policyVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDurationSeconds",
        "maxToolCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "network"
      ],
      "properties": {
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "network": { "enum": ["none", "private-gateway-only"] }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "plan": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "planQuorum": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "executionAuthorization": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "planReviewOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "rejectionReview", "decidedAt"],
      "properties": {
        "status": { "const": "rejected" },
        "rejectionReview": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "reasonCode": { "type": "string", "pattern": "^mission\\.[a-z0-9_.-]+$", "maxLength": 128 },
        "decidedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "protectedHumanGate": { "$ref": "common.v1.schema.json#/$defs/approvalReference" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "runHarnessAttestation": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "reviews": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
    },
    "eventCursor": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "evidence", "contributorLineage", "submittedAt"],
      "properties": {
        "artifact": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "evidence": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "contributorLineage": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "submittedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "resultQuorum": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "decidedAt"],
      "properties": {
        "status": { "enum": ["validated", "rejected", "abandoned"] },
        "rejectionReview": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "reasonCode": { "type": "string", "pattern": "^mission\\.[a-z0-9_.-]+$", "maxLength": 128 },
        "decidedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "assessed",
              "plan-review",
              "plan-rejected",
              "authorized",
              "running",
              "blocked",
              "paused",
              "cancelled",
              "result-submitted",
              "result-review",
              "validated",
              "rejected",
              "failed"
            ]
          }
        },
        "required": ["state"]
      },
      "then": { "type": "object", "properties": { "risk": true }, "required": ["risk"] }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "plan-review",
              "plan-rejected",
              "authorized",
              "running",
              "blocked",
              "paused",
              "cancelled",
              "result-submitted",
              "result-review",
              "validated",
              "rejected",
              "failed"
            ]
          }
        },
        "required": ["state"]
      },
      "then": { "type": "object", "properties": { "plan": true }, "required": ["plan"] }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "authorized",
              "running",
              "blocked",
              "paused",
              "cancelled",
              "result-submitted",
              "result-review",
              "validated",
              "rejected",
              "failed"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "properties": { "planQuorum": true, "executionAuthorization": true },
        "required": ["planQuorum", "executionAuthorization"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "running",
              "blocked",
              "paused",
              "cancelled",
              "result-submitted",
              "result-review",
              "validated",
              "rejected",
              "failed"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "properties": { "runId": true, "runHarnessAttestation": true },
        "required": ["runId", "runHarnessAttestation"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": { "enum": ["result-submitted", "result-review", "validated", "rejected"] }
        },
        "required": ["state"]
      },
      "then": { "type": "object", "properties": { "result": true }, "required": ["result"] }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "plan-rejected" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "properties": { "planReviewOutcome": true },
        "required": ["planReviewOutcome"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "validated" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["resultQuorum", "validation"],
        "properties": {
          "resultQuorum": true,
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "validated" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "rejected" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["validation"],
        "properties": {
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "rejected" }, "rejectionReview": true },
            "required": ["status", "rejectionReview"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "abandoned" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["validation"],
        "properties": {
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "abandoned" } },
            "required": ["status"]
          }
        }
      }
    }
  ]
}
