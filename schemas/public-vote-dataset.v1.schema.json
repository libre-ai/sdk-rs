{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/public-vote-dataset.v1.schema.json",
  "title": "Libre AI Public Vote Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "scope",
    "methodId",
    "methodDigest",
    "statements",
    "publishedAt",
    "digest",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.public-vote-dataset.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "scope": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "methodId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "methodDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "wording",
          "source",
          "votesFor",
          "votesAgainst",
          "abstentions",
          "absent"
        ],
        "properties": {
          "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "wording": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "source": { "$ref": "common.v1.schema.json#/$defs/sourceReference" },
          "votesFor": { "type": "integer", "minimum": 0 },
          "votesAgainst": { "type": "integer", "minimum": 0 },
          "abstentions": { "type": "integer", "minimum": 0 },
          "absent": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "publishedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "methodological-review" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "legal-privacy-review" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": { "$ref": "common.v1.schema.json#/$defs/approvalReference" }
    }
  }
}
