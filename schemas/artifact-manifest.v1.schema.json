{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/artifact-manifest.v1.schema.json",
  "title": "Libre AI Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "artifactType", "createdAt", "digest", "files"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.artifact-manifest.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "artifactType": { "enum": ["build", "dataset", "export", "release", "evidence"] },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest", "mediaType"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$",
            "maxLength": 1024
          },
          "size": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
          "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "mediaType": { "type": "string", "minLength": 3, "maxLength": 255 }
        }
      }
    },
    "evidenceReport": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "artifactType": { "enum": ["build", "release"] } },
        "required": ["artifactType"]
      },
      "then": {
        "type": "object",
        "properties": { "evidenceReport": true },
        "required": ["evidenceReport"]
      }
    }
  ]
}
