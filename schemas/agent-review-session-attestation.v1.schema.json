{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/agent-review-session-attestation.v1.schema.json",
  "title": "Libre AI AgentReviewSessionAttestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "subjectDigest",
    "reviewerAgentId",
    "reviewerRunId",
    "reviewerManifestDigest",
    "reviewerPoolId",
    "runtimeFamily",
    "modelFamily",
    "providerId",
    "isolationProfileDigest",
    "harnessAttestation",
    "readOnlyWorkspace",
    "sharedMutableState",
    "siblingVerdictDisclosed",
    "issuedAt",
    "expiresAt",
    "signingKeyId",
    "attestationDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.agent-review-session-attestation.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "reviewerAgentId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "reviewerRunId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "reviewerManifestDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "reviewerPoolId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "runtimeFamily": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "modelFamily": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "providerId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "isolationProfileDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "harnessAttestation": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "readOnlyWorkspace": { "const": true },
    "sharedMutableState": { "const": false },
    "siblingVerdictDisclosed": { "const": false },
    "issuedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "signingKeyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "attestationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  }
}
