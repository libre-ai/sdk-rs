{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/curated-item-export.v2.schema.json",
  "title": "Libre AI Curated Item Export v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "exportedAt", "items"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.curated-item-export.v2" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "exportedAt": { "type": "string", "format": "date-time", "maxLength": 32 },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "sourceUrl",
          "title",
          "normalizedDigest",
          "decision",
          "ruleSetId",
          "ruleSetVersion",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^urn:libre-ai:[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$"
          },
          "sourceId": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^urn:libre-ai:[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://(?![^/?#]*@)"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "normalizedDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "decision": { "enum": ["retain", "reject"] },
          "ruleSetId": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^urn:libre-ai:[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$"
          },
          "ruleSetVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "decidedAt": { "type": "string", "format": "date-time", "maxLength": 32 }
        }
      }
    }
  }
}
