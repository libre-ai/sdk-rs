{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/notebook-backup-seal-request.v2.schema.json",
  "title": "Libre AI Notebook Backup Seal Request v2",
  "description": "Serializable projection for conformance fixtures. The WIT boundary carries decoded bytes and passes the recovery secret separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "cipher", "kdf", "nonce", "plaintext"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.notebook-backup-seal-request.v2" },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:backup:[a-f0-9]{32}$",
      "minLength": 52,
      "maxLength": 52
    },
    "cipher": { "const": "aes-256-gcm" },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "memoryKiB",
        "iterations",
        "parallelism",
        "outputLengthBytes",
        "salt"
      ],
      "properties": {
        "algorithm": { "const": "argon2id" },
        "version": { "const": 19 },
        "memoryKiB": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 131072,
          "multipleOf": 1024
        },
        "iterations": { "type": "integer", "minimum": 3, "maximum": 4 },
        "parallelism": { "type": "integer", "enum": [1, 2, 4] },
        "outputLengthBytes": { "const": 32 },
        "salt": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]{22}==$",
          "minLength": 24,
          "maxLength": 24
        }
      }
    },
    "nonce": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^[A-Za-z0-9+/]{16}$",
      "minLength": 16,
      "maxLength": 16
    },
    "plaintext": {
      "type": "string",
      "contentEncoding": "base64",
      "contentMediaType": "application/octet-stream",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 4,
      "maxLength": 22369624
    }
  }
}
