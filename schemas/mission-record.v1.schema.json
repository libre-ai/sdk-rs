{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/mission-record.v1.schema.json",
  "title": "Libre AI MissionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "revision",
    "state",
    "handoffId",
    "handoffDigest",
    "budgets",
    "acceptanceCriteria",
    "eventCursor",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.mission-record.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "revision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "state": {
      "enum": [
        "proposed",
        "assessed",
        "approved",
        "refused",
        "running",
        "blocked",
        "paused",
        "cancelled",
        "result-submitted",
        "accepted",
        "rejected",
        "abandoned"
      ]
    },
    "handoffId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "handoffDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "policyVersion"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "policyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationSeconds", "maxToolCalls", "network"],
      "properties": {
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "network": { "enum": ["none", "allowlisted"] }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "common.v1.schema.json#/$defs/approvalReference" }
    },
    "eventCursor": { "type": "integer", "minimum": 0 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "evidence", "submittedAt"],
      "properties": {
        "artifact": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "evidence": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "submittedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "decidedAt"],
      "properties": {
        "status": { "enum": ["accepted", "rejected", "abandoned"] },
        "reasonCode": { "type": "string", "pattern": "^mission\\.[a-z0-9_.-]+$" },
        "decidedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "assessed" } },
        "required": ["state"]
      },
      "then": { "type": "object", "properties": { "risk": true }, "required": ["risk"] }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "approved",
              "refused",
              "running",
              "blocked",
              "paused",
              "cancelled",
              "result-submitted",
              "accepted",
              "rejected",
              "abandoned"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "properties": { "risk": true, "approvals": true },
        "required": ["risk", "approvals"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "result-submitted" } },
        "required": ["state"]
      },
      "then": { "type": "object", "properties": { "result": true }, "required": ["result"] }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "accepted" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["result", "verdict"],
        "properties": {
          "result": true,
          "verdict": {
            "type": "object",
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "rejected" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["result", "verdict"],
        "properties": {
          "result": true,
          "verdict": {
            "type": "object",
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "state": { "const": "abandoned" } },
        "required": ["state"]
      },
      "then": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "verdict": {
            "type": "object",
            "properties": { "status": { "const": "abandoned" } },
            "required": ["status"]
          }
        }
      }
    }
  ]
}
