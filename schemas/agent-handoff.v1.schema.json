{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/agent-handoff.v1.schema.json",
  "title": "Libre AI Agent Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "specPackageId",
    "specPackageDigest",
    "capabilities",
    "acceptanceCriteria",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.agent-handoff.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "specPackageId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "specPackageDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "plan" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "evidenceReports": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
    },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  }
}
