{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/orchestrator-control.v1.schema.json",
  "title": "Libre AI OrchestratorControl v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "planDigest",
    "authorizationDigest",
    "action",
    "expectedRevision",
    "idempotencyKey",
    "reasonCode",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.orchestrator-control.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "authorizationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "action": { "enum": ["start", "pause", "resume", "cancel"] },
    "expectedRevision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idem_[a-z0-9]{16,64}$",
      "minLength": 21,
      "maxLength": 69
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^orchestrator\\.[a-z0-9_.-]+$",
      "minLength": 14,
      "maxLength": 128
    },
    "issuedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "action": { "const": "start" } },
        "required": ["action"]
      },
      "then": {
        "type": "object",
        "properties": { "runId": false }
      },
      "else": {
        "type": "object",
        "properties": { "runId": true },
        "required": ["runId"]
      }
    }
  ]
}
