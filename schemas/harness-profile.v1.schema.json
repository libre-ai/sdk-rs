{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/harness-profile.v1.schema.json",
  "title": "Libre AI HarnessProfile v1",
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._@*+-]+(?:/[A-Za-z0-9._@*+-]+)*$",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "enforcement",
    "supportedPlatforms",
    "filesystem",
    "process",
    "sandboxEngine",
    "workerTransport",
    "providerGateway",
    "privilegedToolBroker",
    "outputs",
    "operationalLogs",
    "attestation",
    "profileDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.harness-profile.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "enforcement": { "const": "required" },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["linux-x86_64", "linux-aarch64", "macos-x86_64", "macos-aarch64"] }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "canonicalizePaths",
        "resolveSymlinks",
        "symlinkPolicy",
        "readOnly",
        "writable",
        "denied",
        "copyIgnoredFiles"
      ],
      "properties": {
        "workspaceRoot": { "const": "/workspace" },
        "canonicalizePaths": { "const": true },
        "resolveSymlinks": { "const": true },
        "symlinkPolicy": { "const": "deny-outside-workspace" },
        "readOnly": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "writable": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "denied": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "copyIgnoredFiles": { "const": false }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedicatedIdentity",
        "denyPrivilegeEscalation",
        "dropAmbientCapabilities",
        "killProcessGroup",
        "maxProcesses",
        "maxDurationSeconds"
      ],
      "properties": {
        "dedicatedIdentity": { "const": true },
        "denyPrivilegeEscalation": { "const": true },
        "dropAmbientCapabilities": { "const": true },
        "killProcessGroup": { "const": true },
        "maxProcesses": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 }
      }
    },
    "sandboxEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "requiredCapabilities", "denyOnMissing"],
      "properties": {
        "manifest": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
        },
        "denyOnMissing": { "const": true }
      }
    },
    "workerTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verifyOsPeer", "runBoundToken", "hostLoopbackAllowed"],
      "properties": {
        "kind": { "enum": ["private-unix-socket", "private-network-namespace"] },
        "verifyOsPeer": { "const": true },
        "runBoundToken": { "const": true },
        "hostLoopbackAllowed": { "const": false }
      }
    },
    "providerGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstreamSecretInWorker",
        "bindExactOrigins",
        "pinResolvedAddress",
        "revalidateRedirects",
        "denySpecialUseAddresses",
        "allowLoopbackUpstream"
      ],
      "properties": {
        "upstreamSecretInWorker": { "const": false },
        "bindExactOrigins": { "const": true },
        "pinResolvedAddress": { "const": true },
        "revalidateRedirects": { "const": true },
        "denySpecialUseAddresses": { "const": true },
        "allowLoopbackUpstream": { "const": false }
      }
    },
    "privilegedToolBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretsInWorker",
        "oneShotCapabilities",
        "revalidatePlan",
        "revalidateBudget",
        "revalidateExpiry",
        "structuredArguments",
        "resolveExecutable",
        "rejectShellSyntax",
        "allowGenericShell",
        "failClosedOutputScan"
      ],
      "properties": {
        "secretsInWorker": { "const": false },
        "oneShotCapabilities": { "const": true },
        "revalidatePlan": { "const": true },
        "revalidateBudget": { "const": true },
        "revalidateExpiry": { "const": true },
        "structuredArguments": { "const": true },
        "resolveExecutable": { "const": true },
        "rejectShellSyntax": { "const": true },
        "allowGenericShell": { "const": false },
        "failClosedOutputScan": { "const": true }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytesPerTool", "maxTotalBytes", "privateByDefault"],
      "properties": {
        "maxBytesPerTool": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "privateByDefault": { "const": true }
      }
    },
    "operationalLogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closedCategoriesAndCountersOnly",
        "contentFieldsAllowed",
        "stableBusinessIdentifiersAllowed",
        "externalOtelEnabled",
        "maxRetentionHours",
        "timestampPrecisionSeconds"
      ],
      "properties": {
        "closedCategoriesAndCountersOnly": { "const": true },
        "contentFieldsAllowed": { "const": false },
        "stableBusinessIdentifiersAllowed": { "const": false },
        "externalOtelEnabled": { "const": false },
        "maxRetentionHours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "timestampPrecisionSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindRequestedProfile",
        "bindEffectiveControls",
        "bindWorkerManifests",
        "bindKernelCapabilities",
        "signed"
      ],
      "properties": {
        "bindRequestedProfile": { "const": true },
        "bindEffectiveControls": { "const": true },
        "bindWorkerManifests": { "const": true },
        "bindKernelCapabilities": { "const": true },
        "signed": { "const": true }
      }
    },
    "profileDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
