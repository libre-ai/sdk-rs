{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/correction-record.v1.schema.json",
  "title": "Libre AI Correction Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "projectionId",
    "previousDigest",
    "correctedDigest",
    "reason",
    "correctedAt",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.correction-record.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "projectionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "previousDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "correctedDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "correctedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "approval": { "$ref": "common.v1.schema.json#/$defs/approvalReference" }
  }
}
