{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/agent-review-quorum-view.v1.schema.json",
  "title": "Libre AI AgentReviewQuorumView v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "missionId",
    "subjectType",
    "subjectDigest",
    "quorumDigest",
    "identityMode",
    "reviewers",
    "contributorCount",
    "retentionPolicyId",
    "retentionExpiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.agent-review-quorum-view.v1" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subjectType": { "enum": ["execution-plan", "mission-result"] },
    "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "quorumDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "identityMode": { "enum": ["redacted", "need-to-know"] },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewDigest", "verdict", "summary"],
        "properties": {
          "reviewDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "reviewerAgentId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "verdict": { "const": "approve" },
          "summary": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "severity", "count"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^review\\.[a-z0-9_.-]+$",
                  "maxLength": 128
                },
                "severity": { "enum": ["minor", "info"] },
                "count": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          }
        }
      }
    },
    "contributorCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "contributorAgentIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "retentionPolicyId": { "const": "mission-record" },
    "retentionExpiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "identityMode": { "const": "redacted" } },
        "required": ["identityMode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "contributorAgentIds": false,
          "reviewers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "reviewerAgentId": false }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "required": ["contributorAgentIds"],
        "properties": {
          "contributorAgentIds": true,
          "reviewers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "reviewerAgentId": true },
              "required": ["reviewerAgentId"]
            }
          }
        }
      }
    }
  ]
}
