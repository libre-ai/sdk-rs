{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/execution-transfer.v1.schema.json",
  "title": "Libre AI ExecutionTransfer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "predecessorRunId",
    "predecessorPlanDigest",
    "currentGeneration",
    "expectedRevision",
    "successorPlanDigest",
    "idempotencyKey",
    "issuedAt",
    "expiresAt",
    "transferDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.execution-transfer.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "predecessorRunId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "predecessorPlanDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "currentGeneration": { "type": "integer", "minimum": 1, "maximum": 999999999 },
    "expectedRevision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "successorPlanDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "maxLength": 128
    },
    "issuedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "transferDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
