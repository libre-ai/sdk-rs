{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/step-invocation.v1.schema.json",
  "title": "Libre AI StepInvocation v1",
  "$defs": {
    "remainingBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "toolCalls",
        "inputTokens",
        "outputTokens",
        "processesStarted",
        "filesChanged",
        "changedBytes"
      ],
      "properties": {
        "durationSeconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
        "toolCalls": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "processesStarted": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "filesChanged": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "changedBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "planDigest",
    "graphDigest",
    "runId",
    "generation",
    "stepId",
    "attemptId",
    "workerInvocationId",
    "causeEventDigest",
    "selectedEdgeId",
    "harnessProfile",
    "workerManifest",
    "remainingBudgets",
    "inputArtifactRef",
    "createdAt",
    "invocationDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.step-invocation.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "graphDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "stepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "attemptId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "workerInvocationId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "causeEventDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "selectedEdgeId": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/urn" }]
    },
    "harnessProfile": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "workerManifest": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "remainingBudgets": { "$ref": "#/$defs/remainingBudgets" },
    "inputArtifactRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "invocationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
