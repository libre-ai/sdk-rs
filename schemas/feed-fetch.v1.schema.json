{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/feed-fetch.v1.schema.json",
  "title": "Libre AI Feed Fetch Request or Result v1",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/result" }],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "kind", "tenantId", "sourceId", "fetchId", "scheduledAt"],
      "properties": {
        "schemaVersion": { "const": "libre-ai.feed-fetch.v1" },
        "kind": { "enum": ["request", "result"] },
        "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
        "sourceId": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "fetchId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "scheduledAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
      }
    },
    "request": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "kind",
            "tenantId",
            "sourceId",
            "fetchId",
            "scheduledAt",
            "url",
            "limits"
          ],
          "properties": {
            "schemaVersion": true,
            "kind": { "const": "request" },
            "tenantId": true,
            "sourceId": true,
            "fetchId": true,
            "scheduledAt": true,
            "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxBytes", "timeoutMs", "maxRedirects"],
              "properties": {
                "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
                "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
                "maxRedirects": { "type": "integer", "minimum": 0, "maximum": 5 }
              }
            }
          }
        }
      ]
    },
    "result": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "kind",
            "tenantId",
            "sourceId",
            "fetchId",
            "scheduledAt",
            "status",
            "completedAt",
            "itemDigests"
          ],
          "properties": {
            "schemaVersion": true,
            "kind": { "const": "result" },
            "tenantId": true,
            "sourceId": true,
            "fetchId": true,
            "scheduledAt": true,
            "status": { "enum": ["accepted", "not-modified", "rejected", "failed"] },
            "completedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
            "reasonCode": { "type": "string", "pattern": "^radar\\.[a-z0-9_.-]+$" },
            "itemDigests": {
              "type": "array",
              "maxItems": 5000,
              "items": { "$ref": "common.v1.schema.json#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "status": { "enum": ["rejected", "failed"] } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": { "reasonCode": true },
            "required": ["reasonCode"]
          }
        }
      ]
    }
  }
}
