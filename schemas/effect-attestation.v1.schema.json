{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/effect-attestation.v1.schema.json",
  "title": "Libre AI EffectAttestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "planDigest",
    "graphDigest",
    "runId",
    "generation",
    "stepId",
    "attemptId",
    "workerInvocationId",
    "effectId",
    "effectEmissionId",
    "effectRequestDigest",
    "destinationRef",
    "executorProfileRef",
    "fencingValue",
    "executorIdempotencyEvidence",
    "status",
    "observationRef",
    "reservedAt",
    "observedAt",
    "signingKeyId",
    "preimageDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.effect-attestation.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "graphDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "stepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "attemptId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "workerInvocationId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "effectId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "effectEmissionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "effectRequestDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "destinationRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "executorProfileRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "fencingValue": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 1000000000 }]
    },
    "executorIdempotencyEvidence": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/artifactReference" }]
    },
    "status": {
      "enum": [
        "reserved",
        "started",
        "committed",
        "rejected-final",
        "not-committed-final",
        "state-unknown"
      ]
    },
    "observationRef": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/artifactReference" }]
    },
    "reservedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "observedAt": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/timestamp" }]
    },
    "signingKeyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "preimageDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fencingValue": { "type": "integer", "minimum": 1 },
            "executorIdempotencyEvidence": { "type": "null" }
          }
        },
        {
          "type": "object",
          "properties": {
            "fencingValue": { "type": "null" },
            "executorIdempotencyEvidence": {
              "$ref": "common.v1.schema.json#/$defs/artifactReference"
            }
          }
        }
      ]
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": ["committed", "rejected-final", "not-committed-final", "state-unknown"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "observationRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
          "observedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "observationRef": { "type": "null" },
          "observedAt": { "type": "null" }
        }
      }
    }
  ]
}
