{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/public-projection.v1.schema.json",
  "title": "Libre AI Public Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "route",
    "locale",
    "title",
    "summary",
    "sourceDigest",
    "reviewedAt",
    "claims"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.public-projection.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "route": { "type": "string", "pattern": "^/(?:[a-z0-9-]+/)*[a-z0-9-]*$", "maxLength": 512 },
    "locale": { "enum": ["fr"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sourceDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "reviewedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "claims": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sources"],
        "properties": {
          "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "$ref": "common.v1.schema.json#/$defs/sourceReference" }
          }
        }
      }
    }
  }
}
