{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/evidence-report.v1.schema.json",
  "title": "Libre AI Evidence Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "subject",
    "subjectDigest",
    "status",
    "checks",
    "generatedAt",
    "producer"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.evidence-report.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subject": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "status": { "enum": ["pass", "fail", "indeterminate"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "ruleVersion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "status": { "enum": ["pass", "fail", "indeterminate"] },
          "ruleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "evidence": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
          "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": { "status": { "enum": ["fail", "indeterminate"] } },
              "required": ["status"]
            },
            "then": {
              "type": "object",
              "properties": { "reasonCode": true },
              "required": ["reasonCode"]
            }
          }
        ]
      }
    },
    "generatedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "pass" } },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "fail" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "status": { "const": "fail" } },
              "required": ["status"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "indeterminate" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "status": { "const": "indeterminate" } },
              "required": ["status"]
            },
            "minContains": 1,
            "not": {
              "contains": {
                "type": "object",
                "properties": { "status": { "const": "fail" } },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  ]
}
