{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/policy-definition.v2.schema.json",
  "title": "Libre AI Policy Definition v2",
  "$defs": {
    "opaquePrincipalId": {
      "type": "string",
      "pattern": "^(?:usr|svc)_[a-z0-9]{16,64}$"
    },
    "opaqueUserId": {
      "type": "string",
      "pattern": "^usr_[a-z0-9]{16,64}$"
    },
    "factScalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+~-]{0,255}$"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "boolean" }
      ]
    },
    "factSet": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+~-]{0,255}$"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "boolean" }
        }
      ]
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "retrievedAt", "digest", "licence"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "licence": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "operator", "value", "unknown", "source"],
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "fact": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:model|need)\\.[a-z][a-z0-9_.-]+$"
        },
        "operator": {
          "enum": ["equals", "not-equals", "in", "not-in", "at-least", "at-most"]
        },
        "value": {
          "oneOf": [{ "$ref": "#/$defs/factScalar" }, { "$ref": "#/$defs/factSet" }]
        },
        "unknown": { "enum": ["indeterminate", "ineligible"] },
        "source": { "$ref": "#/$defs/policySource" },
        "maxSourceAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "enum": ["equals", "not-equals"] } },
            "required": ["operator"]
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/factScalar" } } }
        },
        {
          "if": {
            "properties": { "operator": { "enum": ["in", "not-in"] } },
            "required": ["operator"]
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/factSet" } } }
        },
        {
          "if": {
            "properties": { "operator": { "enum": ["at-least", "at-most"] } },
            "required": ["operator"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": { "maxSourceAgeDays": { "type": "integer" } },
            "required": ["maxSourceAgeDays"]
          },
          "then": {
            "properties": { "fact": { "type": "string", "pattern": "^model\\." } }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "version",
    "status",
    "proposedBy",
    "rules",
    "digest",
    "approvedAt",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.policy-definition.v2" },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:policy:[A-Za-z0-9._~-]+$"
    },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "const": "approved" },
    "proposedBy": { "$ref": "#/$defs/opaquePrincipalId" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rule" }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "approvedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actorKind", "approverId", "approvedAt", "reference", "subjectDigest"],
      "properties": {
        "role": { "const": "policy-approver" },
        "actorKind": { "const": "human" },
        "approverId": { "$ref": "#/$defs/opaqueUserId" },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "reference": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      }
    }
  }
}
