{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/policy-need.v1.schema.json",
  "title": "Libre AI Policy Need v1",
  "$defs": {
    "factScalar": {
      "oneOf": [
        { "type": "string", "maxLength": 5000 },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "boolean" }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "facts", "digest"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.policy-need.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^need\\.[a-z][a-z0-9_.-]+$"
          },
          "value": { "$ref": "#/$defs/factScalar" }
        }
      }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
