{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/radar-rule-evaluation.v1.schema.json",
  "title": "Libre AI Radar Rule Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "itemDigest",
    "ruleSetDigest",
    "ruleSetId",
    "ruleSetVersion",
    "decision",
    "reasonCode",
    "decidingRuleId",
    "explanation",
    "ruleResults"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.radar-rule-evaluation.v1" },
    "itemDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "ruleSetDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "ruleSetId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "ruleSetVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "decision": { "enum": ["retain", "reject"] },
    "reasonCode": { "enum": ["radar.rule_matched", "radar.default_reject"] },
    "decidingRuleId": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/identifier" }]
    },
    "explanation": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 500 }]
    },
    "ruleResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "matched"],
        "properties": {
          "ruleId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "matched": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "reasonCode": { "const": "radar.default_reject" } },
        "required": ["reasonCode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "decision": { "const": "reject" },
          "decidingRuleId": { "type": "null" },
          "explanation": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "reasonCode": { "const": "radar.rule_matched" } },
        "required": ["reasonCode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "decidingRuleId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  ]
}
