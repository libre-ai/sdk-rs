{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/session-export.v1.schema.json",
  "title": "Libre AI Session Export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "sessionId",
    "audience",
    "exportedAt",
    "sources",
    "contributions",
    "approvedOutcomes",
    "eventCursor",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.session-export.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "sessionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "audience": { "enum": ["facilitators", "session"] },
    "exportedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "common.v1.schema.json#/$defs/sourceReference" }
    },
    "contributions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audience", "contentDigest"],
        "properties": {
          "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
          "audience": { "enum": ["facilitators", "session"] },
          "contentDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
        }
      }
    },
    "approvedOutcomes": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
    },
    "eventCursor": { "type": "integer", "minimum": 0 },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
