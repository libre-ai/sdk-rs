{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/agent-review-quorum.v1.schema.json",
  "title": "Libre AI AgentReviewQuorum v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "subjectType",
    "subjectDigest",
    "contributorLineageDigest",
    "reviews",
    "diversityRequirements",
    "policyDigest",
    "reachedAt",
    "quorumDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.agent-review-quorum.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subjectType": { "enum": ["execution-plan", "mission-result"] },
    "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "contributorLineageDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "agent-review.v1.schema.json" }
    },
    "diversityRequirements": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["reviewer-pool", "runtime-family", "model-family", "provider"] }
    },
    "policyDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "protectedHumanGate": { "$ref": "common.v1.schema.json#/$defs/approvalReference" },
    "reachedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "quorumDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
