{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/local-comparison.v2.schema.json",
  "title": "Libre AI Local Comparison v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetDigest",
    "methodId",
    "methodDigest",
    "responseSetDigest",
    "score",
    "denominator",
    "omitted",
    "contributions",
    "computedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.local-comparison.v2"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^urn:libre-ai:dataset:[A-Za-z0-9._~-]+$"
    },
    "datasetDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "methodId": {
      "type": "string",
      "pattern": "^urn:libre-ai:method:[A-Za-z0-9._~-]+$"
    },
    "methodDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "responseSetDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "denominator": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "omitted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statementId", "contribution", "votesConsidered", "votesOmitted"],
        "properties": {
          "statementId": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "contribution": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "votesConsidered": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "votesOmitted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "computedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
