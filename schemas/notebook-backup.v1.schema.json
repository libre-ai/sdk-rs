{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/notebook-backup.v1.schema.json",
  "title": "Libre AI Notebook Backup Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "cipher",
    "kdf",
    "nonce",
    "ciphertext",
    "ciphertextDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.notebook-backup.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "cipher": { "const": "aes-256-gcm" },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "salt", "memoryKiB", "iterations", "parallelism"],
      "properties": {
        "algorithm": { "const": "argon2id" },
        "salt": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 22,
          "maxLength": 128
        },
        "memoryKiB": { "type": "integer", "minimum": 65536, "maximum": 1048576 },
        "iterations": { "type": "integer", "minimum": 3, "maximum": 20 },
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "nonce": { "type": "string", "contentEncoding": "base64", "minLength": 16, "maxLength": 24 },
    "ciphertext": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 24,
      "maxLength": 139810136
    },
    "ciphertextDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
