{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/harness-attestation.v1.schema.json",
  "title": "Libre AI HarnessAttestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "runId",
    "planDigest",
    "requestedProfileDigest",
    "effectiveProfileDigest",
    "workerManifestDigests",
    "sandboxEngineManifest",
    "platform",
    "effectiveControls",
    "networkMode",
    "generatedAt",
    "signingKeyId",
    "attestationDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.harness-attestation.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "requestedProfileDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "effectiveProfileDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "workerManifestDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/sha256" }
    },
    "sandboxEngineManifest": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "platform": { "enum": ["linux-x86_64", "linux-aarch64", "macos-x86_64", "macos-aarch64"] },
    "effectiveControls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "networkMode": { "enum": ["none", "private-gateway-only"] },
    "generatedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "signingKeyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "attestationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  }
}
