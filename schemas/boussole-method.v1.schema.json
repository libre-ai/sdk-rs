{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/boussole-method.v1.schema.json",
  "title": "Libre AI Boussole Method v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "responseScale",
    "abstentionTreatment",
    "missingTreatment",
    "formula",
    "approvedAt",
    "digest",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.boussole-method.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "responseScale": {
      "type": "array",
      "minItems": 2,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": -5, "maximum": 5 }
    },
    "abstentionTreatment": { "enum": ["excluded-from-denominator", "neutral"] },
    "missingTreatment": { "const": "excluded-and-reported" },
    "formula": { "enum": ["normalized-agreement-v1"] },
    "approvedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "methodological-review" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "legal-privacy-review" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": { "$ref": "common.v1.schema.json#/$defs/approvalReference" }
    }
  }
}
