{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/model-snapshot.v2.schema.json",
  "title": "Libre AI Model Snapshot v2",
  "$defs": {
    "factScalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+~-]{0,255}$"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "boolean" }
      ]
    },
    "factSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "retrievedAt", "digest", "licence"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "licence": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "modelId", "capturedAt", "facts", "digest"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.model-snapshot.v2" },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:snapshot:[A-Za-z0-9._~-]+$"
    },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "modelId": {
      "type": "string",
      "pattern": "^mdl_[a-z0-9]{16,64}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "source"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^model\\.[a-z][a-z0-9_.-]+$"
          },
          "value": { "$ref": "#/$defs/factScalar" },
          "source": { "$ref": "#/$defs/factSource" }
        }
      }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
