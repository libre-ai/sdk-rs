{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/agent-contributor-lineage.v1.schema.json",
  "title": "Libre AI AgentContributorLineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "subjectDigest",
    "contributors",
    "observations",
    "generatedAt",
    "signingKeyId",
    "lineageDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.agent-contributor-lineage.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "contributors": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "roles", "contributionDigest"],
        "properties": {
          "agentId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["author", "executor", "fixer", "editor"] }
          },
          "contributionDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
    },
    "generatedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "signingKeyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "lineageDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  }
}
