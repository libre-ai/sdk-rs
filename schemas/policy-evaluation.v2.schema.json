{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/policy-evaluation.v2.schema.json",
  "title": "Libre AI Policy Evaluation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "policyId",
    "policyDigest",
    "snapshotId",
    "snapshotDigest",
    "needDigest",
    "engineVersion",
    "verdict",
    "ruleResults",
    "evaluatedAt",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.policy-evaluation.v2" },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:evaluation:[a-f0-9]{64}$"
    },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "policyId": {
      "type": "string",
      "pattern": "^urn:libre-ai:policy:[A-Za-z0-9._~-]+$"
    },
    "policyDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "snapshotId": {
      "type": "string",
      "pattern": "^urn:libre-ai:snapshot:[A-Za-z0-9._~-]+$"
    },
    "snapshotDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "needDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "verdict": { "enum": ["eligible", "ineligible", "indeterminate"] },
    "ruleResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "status", "reasonCode"],
        "properties": {
          "ruleId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "status": { "enum": ["satisfied", "failed", "unknown"] },
          "reasonCode": {
            "enum": [
              "policy.rule_satisfied",
              "policy.rule_failed",
              "policy.fact_absent",
              "policy.fact_type_mismatch",
              "policy.snapshot_stale",
              "policy.source_from_future"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "satisfied" } },
              "required": ["status"]
            },
            "then": {
              "properties": { "reasonCode": { "const": "policy.rule_satisfied" } }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "failed" } },
              "required": ["status"]
            },
            "then": { "properties": { "reasonCode": { "const": "policy.rule_failed" } } }
          },
          {
            "if": {
              "properties": { "status": { "const": "unknown" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "reasonCode": {
                  "enum": [
                    "policy.fact_absent",
                    "policy.fact_type_mismatch",
                    "policy.snapshot_stale",
                    "policy.source_from_future"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "eligible" } },
        "required": ["verdict"]
      },
      "then": {
        "type": "object",
        "properties": {
          "ruleResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "satisfied" } },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "ineligible" } },
        "required": ["verdict"]
      },
      "then": {
        "type": "object",
        "properties": {
          "ruleResults": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "status": { "enum": ["failed", "unknown"] } },
              "required": ["status"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "indeterminate" } },
        "required": ["verdict"]
      },
      "then": {
        "type": "object",
        "properties": {
          "ruleResults": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "status": { "const": "unknown" } },
              "required": ["status"]
            },
            "minContains": 1,
            "not": {
              "contains": {
                "type": "object",
                "properties": { "status": { "const": "failed" } },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  ]
}
