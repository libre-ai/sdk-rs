{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/boussole-method.v2.schema.json",
  "title": "Libre AI Boussole Method v2",
  "$defs": {
    "reviewApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "actorKind",
        "reviewerId",
        "professionalCapacity",
        "approvedAt",
        "reference",
        "subjectDigest",
        "attestation"
      ],
      "properties": {
        "role": {
          "enum": ["methodological-review", "legal-privacy-review"]
        },
        "actorKind": {
          "const": "human"
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^rev_[a-z0-9]{16,64}$"
        },
        "professionalCapacity": {
          "enum": ["methodology-expert", "privacy-legal-expert"]
        },
        "approvedAt": {
          "$ref": "common.v1.schema.json#/$defs/timestamp"
        },
        "reference": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "subjectDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "digest", "publicationBasis", "identityBoundary"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
            },
            "digest": {
              "$ref": "common.v1.schema.json#/$defs/sha256"
            },
            "publicationBasis": {
              "const": "explicit-publication-consent"
            },
            "identityBoundary": {
              "const": "professional-attestation-only"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "methodological-review"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "professionalCapacity": {
                "const": "methodology-expert"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "legal-privacy-review"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "professionalCapacity": {
                "const": "privacy-legal-expert"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "responseScale",
    "abstentionTreatment",
    "missingTreatment",
    "formula",
    "rounding",
    "approvedAt",
    "digest",
    "approvals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.boussole-method.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:method:[A-Za-z0-9._~-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "responseScale": {
      "type": "array",
      "minItems": 2,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": -5,
        "maximum": 5
      }
    },
    "abstentionTreatment": {
      "enum": ["excluded-from-denominator", "neutral"]
    },
    "missingTreatment": {
      "const": "excluded-and-reported"
    },
    "formula": {
      "const": "normalized-agreement-v2"
    },
    "rounding": {
      "const": "decimal-6-half-even"
    },
    "approvedAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "methodological-review"
              }
            },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "legal-privacy-review"
              }
            },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/reviewApproval"
      }
    }
  }
}
