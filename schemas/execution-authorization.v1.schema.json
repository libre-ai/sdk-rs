{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/execution-authorization.v1.schema.json",
  "title": "Libre AI ExecutionAuthorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "missionId",
    "missionRevision",
    "missionRecordDigest",
    "planId",
    "planDigest",
    "planQuorum",
    "revocationId",
    "issuedAt",
    "expiresAt",
    "authorizationDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.execution-authorization.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "missionRevision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "missionRecordDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "planId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "planQuorum": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "protectedHumanGate": { "$ref": "common.v1.schema.json#/$defs/approvalReference" },
    "revocationId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "issuedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "authorizationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
