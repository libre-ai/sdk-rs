{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/boussole-response-set.v2.schema.json",
  "title": "Libre AI Boussole Local Response Set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetDigest",
    "methodId",
    "methodDigest",
    "responses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.boussole-response-set.v2"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^urn:libre-ai:dataset:[A-Za-z0-9._~-]+$"
    },
    "datasetDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "methodId": {
      "type": "string",
      "pattern": "^urn:libre-ai:method:[A-Za-z0-9._~-]+$"
    },
    "methodDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["statementId", "kind", "value"],
            "properties": {
              "statementId": {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              "kind": {
                "const": "answer"
              },
              "value": {
                "type": "integer",
                "minimum": -5,
                "maximum": 5
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["statementId", "kind"],
            "properties": {
              "statementId": {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              "kind": {
                "const": "skip"
              }
            }
          }
        ]
      }
    }
  }
}
