{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/execution-graph.v1.schema.json",
  "title": "Libre AI ExecutionGraph v1",
  "$defs": {
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumAttempts", "retryableOutcomeCodes"],
      "properties": {
        "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 32 },
        "retryableOutcomeCodes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
        }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choices",
        "requiredRole",
        "expiresAfterSeconds",
        "noResponseOutcomeCode",
        "requestSchemaRef",
        "responseSchemaRef"
      ],
      "properties": {
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["choiceId", "outcomeCode"],
            "properties": {
              "choiceId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
              "outcomeCode": { "$ref": "common.v1.schema.json#/$defs/identifier" }
            }
          }
        },
        "requiredRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "maxLength": 64
        },
        "expiresAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "noResponseOutcomeCode": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "requestSchemaRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
        "responseSchemaRef": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
      }
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executorProfileDigest", "reEmissionMode"],
      "properties": {
        "executorProfileDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "reEmissionMode": {
          "enum": [
            "retry-with-executor-idempotency",
            "retry-after-terminal-status-with-fencing",
            "no-retry"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "kind", "outcomeCodes"],
      "properties": {
        "stepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "kind": { "enum": ["calculation", "human-decision", "external-effect", "terminal"] },
        "outcomeCodes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
        },
        "retryPolicy": { "$ref": "#/$defs/retryPolicy" },
        "decisionPolicy": { "$ref": "#/$defs/decisionPolicy" },
        "effectPolicy": { "$ref": "#/$defs/effectPolicy" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "calculation" },
            "outcomeCodes": { "type": "array", "minItems": 1, "maxItems": 16 },
            "retryPolicy": true,
            "decisionPolicy": false,
            "effectPolicy": false
          },
          "required": ["retryPolicy"]
        },
        {
          "properties": {
            "kind": { "const": "human-decision" },
            "outcomeCodes": { "type": "array", "minItems": 1, "maxItems": 16 },
            "retryPolicy": true,
            "decisionPolicy": true,
            "effectPolicy": false
          },
          "required": ["retryPolicy", "decisionPolicy"]
        },
        {
          "properties": {
            "kind": { "const": "external-effect" },
            "outcomeCodes": { "type": "array", "minItems": 1, "maxItems": 16 },
            "retryPolicy": true,
            "effectPolicy": true,
            "decisionPolicy": false
          },
          "required": ["retryPolicy", "effectPolicy"]
        },
        {
          "properties": {
            "kind": { "const": "terminal" },
            "outcomeCodes": { "type": "array", "maxItems": 0 },
            "retryPolicy": false,
            "decisionPolicy": false,
            "effectPolicy": false
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "fromStepId", "outcomeCode", "toStepId"],
      "properties": {
        "edgeId": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "fromStepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "outcomeCode": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "toStepId": { "$ref": "common.v1.schema.json#/$defs/urn" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "entryStepId",
    "steps",
    "edges",
    "createdAt",
    "graphDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.execution-graph.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "entryStepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/step" }
    },
    "edges": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/edge" }
    },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "graphDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
