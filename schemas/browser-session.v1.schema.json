{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/browser-session.v1.schema.json",
  "title": "Libre AI Browser Session Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sessionDigest",
    "userId",
    "tenantId",
    "roles",
    "membershipRevision",
    "oidc",
    "csrfSecretDigest",
    "status",
    "createdAt",
    "lastSeenAt",
    "idleExpiresAt",
    "absoluteExpiresAt",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.browser-session.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "sessionDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "userId": { "type": "string", "pattern": "^usr_[a-z0-9]{16,64}$" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "membershipRevision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subjectDigest", "authenticatedAt"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "subjectDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "authenticatedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
        "assurance": { "type": "string", "pattern": "^[a-z0-9:._-]{1,128}$" }
      }
    },
    "csrfSecretDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "status": { "enum": ["active", "revoked", "expired"] },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "lastSeenAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "idleExpiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "absoluteExpiresAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "revokedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "revocationReason": { "type": "string", "pattern": "^auth\\.[a-z0-9_.-]+$" },
    "revision": { "$ref": "common.v1.schema.json#/$defs/revision" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "revoked" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": { "revokedAt": true, "revocationReason": true },
        "required": ["revokedAt", "revocationReason"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "status": { "enum": ["active", "expired"] } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "not": {
          "anyOf": [
            { "type": "object", "properties": { "revokedAt": true }, "required": ["revokedAt"] },
            {
              "type": "object",
              "properties": { "revocationReason": true },
              "required": ["revocationReason"]
            }
          ]
        }
      }
    }
  ]
}
