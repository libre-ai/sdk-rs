{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/retention-policy.v2.schema.json",
  "title": "Libre AI Retention Policy v2",
  "$defs": {
    "duration": { "type": "string", "pattern": "^P[1-9][0-9]*[DY]$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "dataClass", "location", "mode", "trigger"],
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "owner": {
          "enum": [
            "practices",
            "radar",
            "notebook",
            "sessions",
            "model-policy",
            "boussole",
            "specifications",
            "missions",
            "auth-web",
            "operations",
            "proof-artifact",
            "backup",
            "agent-orchestrator"
          ]
        },
        "dataClass": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "location": {
          "enum": ["memory", "local", "postgresql", "redis", "cellar", "logs", "backup"]
        },
        "mode": { "enum": ["immediate", "fixed", "until-delete", "while-referenced"] },
        "trigger": {
          "enum": [
            "normalization",
            "failure",
            "creation",
            "last-seen",
            "expiry",
            "explicit-delete",
            "reference-release"
          ]
        },
        "defaultRetention": { "$ref": "#/$defs/duration" },
        "postReferenceRetention": { "$ref": "#/$defs/duration" },
        "maximumActiveHours": { "type": "integer", "minimum": 1, "maximum": 24 },
        "configurable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": { "$ref": "#/$defs/duration" },
            "maximum": { "$ref": "#/$defs/duration" }
          },
          "minProperties": 1
        },
        "effectiveRetentionEqualsRule": { "const": "mission-record" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "mode": { "const": "fixed" } },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": { "defaultRetention": true },
            "required": ["defaultRetention"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "mode": { "enum": ["immediate", "until-delete"] } },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "defaultRetention": false,
              "postReferenceRetention": false,
              "configurable": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "orchestrator-execution-record" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": { "effectiveRetentionEqualsRule": { "const": "mission-record" } },
            "required": ["effectiveRetentionEqualsRule"]
          },
          "else": {
            "type": "object",
            "properties": { "effectiveRetentionEqualsRule": false }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "approvedAt", "backupExpiry", "restoreOrder", "rules"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.retention-policy.v2" },
    "authority": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "approvedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "backupExpiry": { "const": "P35D" },
    "restoreOrder": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "const": "execution-deletion-tombstone" },
        { "const": "orchestrator-execution-record" }
      ],
      "items": false
    },
    "rules": {
      "type": "array",
      "minItems": 17,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/rule" }
    }
  }
}
