{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/local-comparison.v1.schema.json",
  "title": "Libre AI Local Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetDigest",
    "methodId",
    "methodDigest",
    "responseSetDigest",
    "score",
    "denominator",
    "omitted",
    "contributions",
    "computedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.local-comparison.v1" },
    "datasetId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "datasetDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "methodId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "methodDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "responseSetDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "score": { "type": "number", "minimum": -1, "maximum": 1 },
    "denominator": { "type": "integer", "minimum": 1 },
    "omitted": { "type": "integer", "minimum": 0 },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statementId", "contribution", "votesConsidered", "votesOmitted"],
        "properties": {
          "statementId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "contribution": { "type": "number", "minimum": -1, "maximum": 1 },
          "votesConsidered": { "type": "integer", "minimum": 0 },
          "votesOmitted": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "computedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  }
}
