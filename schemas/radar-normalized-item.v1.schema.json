{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/radar-normalized-item.v1.schema.json",
  "title": "Libre AI Radar Normalized Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "id",
    "deduplicationKey",
    "externalId",
    "url",
    "sourceHost",
    "title",
    "summary",
    "authors",
    "tags",
    "publishedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.radar-normalized-item.v1" },
    "sourceId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:radar-item:[a-f0-9]{64}$"
    },
    "deduplicationKey": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "externalId": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 2048 }]
    },
    "url": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      ]
    },
    "sourceHost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9.-]{0,253}[a-z0-9])?|\\[[0-9a-f:.]+\\])$"
    },
    "title": { "type": "string", "maxLength": 1000 },
    "summary": { "type": "string", "maxLength": 5000 },
    "authors": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "tags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "publishedAt": { "$ref": "#/$defs/nullableCanonicalTimestamp" },
    "updatedAt": { "$ref": "#/$defs/nullableCanonicalTimestamp" }
  },
  "$defs": {
    "nullableCanonicalTimestamp": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ]
    }
  }
}
