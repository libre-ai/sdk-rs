{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/session-event.v1.schema.json",
  "title": "Libre AI Session Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "sessionId",
    "sequence",
    "revision",
    "type",
    "actor",
    "occurredAt",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.session-event.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "sessionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "sequence": { "type": "integer", "minimum": 1 },
    "revision": { "$ref": "common.v1.schema.json#/$defs/revision" },
    "type": {
      "enum": [
        "member-added",
        "session-created",
        "source-attached",
        "participant-joined",
        "contribution-submitted",
        "synthesis-drafted",
        "outcome-approved",
        "outcome-rejected",
        "session-closed",
        "session-exported",
        "session-deleted"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human", "provider", "system"] },
        "id": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      }
    },
    "occurredAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": { "$ref": "common.v1.schema.json#/$defs/urn" },
        "audience": { "enum": ["private", "facilitators", "session"] },
        "contentDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "reasonCode": { "type": "string", "pattern": "^sessions\\.[a-z0-9_.-]+$" },
        "artifact": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "type": { "const": "contribution-submitted" } },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": { "resourceId": true, "audience": true, "contentDigest": true },
            "required": ["resourceId", "audience", "contentDigest"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "type": { "enum": ["synthesis-drafted", "outcome-approved"] } },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": { "artifact": true },
            "required": ["artifact"]
          }
        }
      }
    }
  ]
}
